# OpenAN Integration Test Environment Variable Contract (template)
# Usage: copy e2e/.env.template to e2e/.env and fill in real values for your environment; committing .env to the repository is prohibited.
# Grouping is described in the OpenAN Integration Testing Process and Framework §6.6.

# ---------- Cluster & Deployment ----------
# Kubernetes cluster access (online Helm mode)
KUBECONFIG=
OPENAN_NAMESPACE=openan
# Deployment mode: online-helm | offline-compose
DEPLOY_MODE=online-helm

# ---------- Service URLs Under Test ----------
# Registry Center (HTTPS, default port 5000)
REGISTRY_CENTER_URL=https://127.0.0.1:5000
# mTLS client certificate (required by Registry Center owner isolation/signature verification)
REGISTRY_CLIENT_CERT=
REGISTRY_CLIENT_KEY=
REGISTRY_CA_CERT=
# For jku allowlist toggle validation (jwk_allowlist in the Registry Center server.conf)
REGISTRY_JWK_ALLOWLIST=
# Orchestration Center (backend 5001 / frontend 3003)
ORCHESTRATION_CENTER_URL=http://127.0.0.1:5001
ORCH_ACCESS_PASSWORD=
# OpenAN Portal (Showroom/Playground)
OPENAN_PORTAL_URL=

# ---------- LLM Dependencies (Registry Center semantic search, Orchestration Center intent/workflow generation) ----------
# Real LLM endpoint (models.yaml + named key injection), or the mock toggle below
LLM_CHAT_API_KEY=
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=
# A2A-T SDK standalone LLM configuration (A2AT_LLM_* in the orchestration-center .env)
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=
# Test determinism toggle: true uses a mock LLM / stub responses
USE_MOCK_LLM=false

# ---------- Sample / Mock Agents ----------
# Sample agent endpoints provided by openan-demo mockagent or Orchestration Center samples
MOCK_AGENTS_HOST=
SAMPLE_AGENTS_HOST=

# ---------- External Database (external MySQL/PostgreSQL in deployment values) ----------
DB_BACKEND=postgresql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# ---------- Images & Artifacts ----------
IMAGE_REGISTRY=ghcr.io/project-openan
IMAGE_TAG=
# Artifact integrity verification (SBOM / image digest)
OPENAN_SBOM_PATH=

# ---------- Execution & Reporting ----------
# Directory for preserving failure scenes (trace/log/screenshots)
EVIDENCE_DIR=evidence

# ---------- OpenAN Installation Testing (openan-installation) ----------
# Machine profile of THIS test host: online-vm | cluster-ops | offline-node
OPENAN_INSTALL_MACHINE_PROFILE=
# Local checkout path of the openan-installation repository (install scripts execute locally; required by online-vm and cluster-ops hosts)
OPENAN_INSTALL_REPO_PATH=
# One-click binary scripts subdirectory (relative to the repo path)
OPENAN_INSTALL_BINARY_SUBDIR=binary/one-click
# LLM endpoint for configure_llm.sh / wizard connectivity validation (OpenAI-compatible)
OPENAN_INSTALL_LLM_MODEL=
OPENAN_INSTALL_LLM_API_URL=
OPENAN_INSTALL_LLM_API_KEY=
# Online Helm wizard install (cluster-ops)
OPENAN_INSTALL_IMAGE_TAG=
OPENAN_INSTALL_ADMIN_PASSWORD=
OPENAN_INSTALL_DB_PASSWORD=
# Build-machine cases (build.sh; later build-offline.sh and pack.sh). Opt-in: set to 1 only on a host with Docker/buildx
OPENAN_INSTALL_BUILD_HOST=
# Reachable image registry the build cases push to (docker login done beforehand)
OPENAN_INSTALL_BUILD_REGISTRY=
OPENAN_INSTALL_BUILD_NAMESPACE=project-openan
# Defaults to OPENAN_INSTALL_IMAGE_TAG when empty
OPENAN_INSTALL_BUILD_TAG=
OPENAN_INSTALL_BUILD_PLATFORMS=linux/amd64
# External database for db-type-003 (lowercase type the services support, e.g. gauss); empty = case skips
OPENAN_INSTALL_EXTERNAL_DB_TYPE=
OPENAN_INSTALL_EXTERNAL_DB_HOST=
OPENAN_INSTALL_EXTERNAL_DB_PORT=
OPENAN_INSTALL_EXTERNAL_DB_PASSWORD=
# Opt-in for cases that change cluster-wide state (reliability-002/004/005); set to 1 only on a dedicated test cluster
OPENAN_INSTALL_DEDICATED_CLUSTER=
# MetalLB pool answered at the wizard "MetalLB IP pool" prompt (routable, unused IPs of the cluster network); required unless the cluster already has openan-pool
OPENAN_INSTALL_METALLB_POOL=
# Frontend choice answered in the wizard: workflow-designer (default) | portal
OPENAN_INSTALL_FRONTEND_TYPE=workflow-designer
# Portal image tag, used when OPENAN_INSTALL_FRONTEND_TYPE=portal
OPENAN_INSTALL_PORTAL_TAG=v1.0.0
# Offline bundles (extracted bundle root directories; empty = the related cases skip)
OPENAN_INSTALL_OFFLINE_K8S_BUNDLE=
OPENAN_INSTALL_OFFLINE_COMPOSE_BUNDLE=
# Offline K8s config.env (absolute, or relative to the K8s bundle root); empty = offline K8s cases skip
OPENAN_INSTALL_OFFLINE_CONFIG_ENV=
# Registry center URL entered at the prompt of the orchestration-only binary install (binary-regurl-001); empty = case skips
OPENAN_INSTALL_REGISTRY_URL=
# Binary offline install directory (install.sh plus dist/*.tar.gz, or the tarballs next to install.sh); empty = case skips
OPENAN_INSTALL_BINARY_OFFLINE_DIR=
# Private registry (host:port) whose images offline-k8s-002 references in the values file; empty = case skips
OPENAN_INSTALL_LOCAL_REGISTRY=
# Source tag for binary-version-001 (a registry-center tag other than the built-in default v1.0.0); empty = case skips
OPENAN_INSTALL_REG_VERSION=
# Local source checkouts with a Dockerfile for build-offline.sh --app-source build (local-build-002); empty = case skips
OPENAN_INSTALL_REGISTRY_SRC=
OPENAN_INSTALL_ORCHESTRATION_SRC=
# Opt-in for compatibility-002/003; set to 1 only on a disposable VM whose runtimes the installer may change
OPENAN_INSTALL_FRESH_VM=
# Optional ssh target of an adjacent machine for the security-005 port probe; empty = host-side probing only
OPENAN_INSTALL_PROBE_HOST=
